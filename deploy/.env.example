POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=change-me-in-prod

MINIO_ROOT_USER=prism
MINIO_ROOT_PASSWORD=change-me-in-prod

JWT_SECRET=dev-only-replace-with-32-plus-random-chars-please

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=analog

# LDAP authentication (optional). When enabled, users sign in with directory
# credentials (search + bind); first-time users are auto-provisioned. The admin
# above stays a LOCAL account and always works even if LDAP is down. See
# docs/source/how-to/configure-ldap.md. Use ldaps:// or START_TLS in production.
# LDAP_ENABLED=true
# LDAP_SERVER=ldap://dir.example.com:389
# LDAP_BIND_DN=cn=service,dc=example,dc=com      # optional; omit for anonymous search
# LDAP_BIND_PASSWORD=change-me
# LDAP_USER_BASE_DN=ou=people,dc=example,dc=com
# LDAP_USER_FILTER=(mail={email})                # supports {email} and {username}
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_START_TLS=false

# Database backups → Cloudsmith (optional). Backs up Postgres and (optionally)
# the MinIO bucket on a schedule, pushes each as a raw package, and keeps only
# the most recent BACKUP_KEEP. Enable the backup container by adding the
# "backup" compose profile and setting a Cloudsmith API key + repo. See
# docs/source/how-to/configure-backups.md.
# COMPOSE_PROFILES=backup
# CLOUDSMITH_API_KEY=your-cloudsmith-api-key
# CLOUDSMITH_REPO=my-org/my-repo
# BACKUP_CRON=0 3 * * *          # daily at 03:00 UTC (standard cron expression)
# BACKUP_KEEP=7                  # retain the 7 most recent of each backup
# BACKUP_INCLUDE_MINIO=true      # also archive the MinIO bucket (can be large)
# BACKUP_S3_BUCKET=prism

# Retention (optional). Default window for `prism-api prune`, which deletes runs
# older than N days and garbage-collects their orphaned artifact blobs. 0 (the
# default) disables retention; --days on the CLI overrides it. Prune is run
# manually or on your own scheduler. See docs/source/how-to/prune-old-runs.md.
# RETENTION_DAYS=90

# Host ports (dev overlay only). Defaults avoid common conflicts with locally
# installed postgres/redis/http servers. Override any of these in your .env.
POSTGRES_HOST_PORT=5433
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
REDIS_HOST_PORT=6380
API_HOST_PORT=8000
WEB_HOST_PORT=8180
DOCS_HOST_PORT=8181
