POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=change-me-in-prod

MINIO_ROOT_USER=prism
MINIO_ROOT_PASSWORD=change-me-in-prod

JWT_SECRET=replace-with-a-long-random-string

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-prod

# Host ports (dev overlay only). Defaults avoid common conflicts with locally
# installed postgres/redis/http servers. Override any of these in your .env.
POSTGRES_HOST_PORT=5433
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
REDIS_HOST_PORT=6380
API_HOST_PORT=8000
WEB_HOST_PORT=8180
