{
  // Default rule set with these adjustments:
  //   MD013 (line-length) — too noisy for prose docs
  //   MD033 (inline HTML) — README uses <p align="center"> for the logo block
  //   MD010 (no-hard-tabs) — disabled inside fenced code blocks because Makefile
  //     recipes require literal TABs; the default --fix would silently mangle them
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD010": { "code_blocks": false }
  },
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    "site/**",
    "**/.venv/**",
    // docs/source is MyST (Sphinx) markdown, not CommonMark — directives, role
    // syntax and label anchors trip generic markdownlint rules. It is linted
    // instead by the strict Sphinx build (`make lint-docs`).
    "docs/source/**",
    "docs/build/**",
    "apps/web/playwright-report/**",
    "apps/web/test-results/**",
    "apps/web/dist/**",
    "**/__pycache__/**"
  ]
}
